{
  // DashView Worker — Cloudflare Workers Builds config
  //
  // WHAT THIS DEPLOYS RIGHT NOW
  //   - Read-only "Odoo Live" path (POST to the Worker root) + AI relay.
  //     This path never touches D1, so it works without a database.
  //   - GET / and GET /api/health  ->  status JSON (what is / is not configured). Open your Worker URL in a browser to check it is alive.
  //
  // NOT ACTIVE YET (needs D1): DashView accounts / sign-in and the stored
  //   Odoo connection + tasks (/api/auth/*, /api/tasks, /api/teams ...).
  //   To turn them on later, follow the "ENABLE D1" block at the bottom.
  //
  // NAME must match the Worker name in Cloudflare (Workers Builds).
  // Yours is "workspace"  ->  https://workspace.youknowumer-io.workers.dev
  "name": "workspace",
  "main": "worker-src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  // Keep Worker logs: Cloudflare -> your Worker -> Logs shows crashes and errors (e.g. "Exceeded CPU limit").
  "observability": { "enabled": true },

  "vars": {
    // Exact frontend origin(s), comma-separated. No path, no trailing slash.
    // (Add a custom domain here later, e.g. "https://artivoralabs.github.io,https://app.example.com")
    "ALLOWED_ORIGINS": "https://artivoralabs.github.io",

    // Odoo hostnames this Worker is allowed to call, comma-separated.
    // REQUIRED: with no value the Odoo relay refuses every request (it needs no login, so this list is its only guard).
    // Use plain hostnames; add "host:port" only if your Odoo really listens on a non-443 port.
    "ALLOWED_ODOO_HOSTS": "edu-artisanauracreations.odoo.com"

    // Once your owner account exists, close public sign-up:
    //   "ALLOW_REGISTRATION": "false"
    // JWT_SECRET (secret, NOT a var) must be 32+ random characters:  openssl rand -base64 48
  },

  // ---------------------------------------------------------------------
  // ENABLE D1 LATER  (accounts / sign-in / tasks)
  //   1. Cloudflare -> Storage & Databases -> D1 -> dashview-db -> copy the Database ID.
  //   2. Remove the leading "//" on the block below and paste the real ID.
  //   3. D1 -> dashview-db -> Console: run the contents of migrations/0001_init.sql
  //   4. Worker -> Settings -> Variables and Secrets: add secrets JWT_SECRET and ODOO_ENC_KEY.
  //   5. Commit -> Workers Builds redeploys.
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "dashview-db",
  //     "database_id": "PASTE-REAL-DATABASE-ID-HERE",
  //     "migrations_dir": "migrations"
  //   }
  // ],
}
