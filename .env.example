# Copy this file to .env and fill in real values. Never commit .env.

# GitHub token with 'read:project' and 'repo' scopes (fine-grained or classic).
GITHUB_TOKEN=

# Your GitHub organization login (case-sensitive as it appears in the org URL).
GITHUB_ORG=ArtivoraLabs

# Port the local server listens on.
PORT=3000

# How long fetched GitHub data is cached, in milliseconds.
CACHE_TTL_MS=60000

# Comma-separated list of origins allowed to call the API in production,
# e.g. https://artivoralabs.github.io. Leave blank to allow all (fine for
# local development only).
ALLOWED_ORIGINS=
